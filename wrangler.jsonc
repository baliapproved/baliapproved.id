{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baliapproved-id",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
