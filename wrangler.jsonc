{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baliapproved-id",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // The Cloudflare Vite plugin fills in the asset directory from the client build.
  // Pages are prerendered, so only server function calls reach the Worker.
  "assets": {
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
