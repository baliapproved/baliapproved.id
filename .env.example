# Public PostHog project token and ingestion host.
# Leave the token empty to disable analytics, including local development.
# Production builds read gitignored .env.production.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Kit (kit.com) newsletter. Server-only secrets, never prefix with VITE_.
# Local values go in gitignored .env.local; deployed values are Worker secrets.
KIT_API_KEY=
