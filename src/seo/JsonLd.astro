---
import type { Graph, Thing, WithContext } from "schema-dts";

interface Props {
  schema: WithContext<Thing> | Graph;
}

// Escaping "<" keeps a stray "</script>" in the data from closing the tag early.
const json = JSON.stringify(Astro.props.schema).replace(/</g, "\\u003c");
---

<script type="application/ld+json" is:inline set:html={json} />
