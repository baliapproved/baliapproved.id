---
import { SubscribeForm } from "@/newsletter/SubscribeForm";
import { site } from "./site";

const currentYear = new Date().getUTCFullYear();

const columns: {
  title: string;
  links: { label: string; href: string; action?: string }[];
}[] = [
  {
    title: "Explore",
    links: [
      { label: "Discover", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: "About", href: "/about" },
    ],
  },
  {
    title: "Follow",
    links: [
      {
        label: "Instagram",
        href: "https://www.instagram.com/bali.approved/",
        action: "instagram_click",
      },
      {
        label: "WhatsApp",
        href: "https://wa.me/6285117325144",
        action: "whatsapp_click",
      },
    ],
  },
  {
    title: "Reviews by",
    links: [
      { label: "@lifeisshorj", href: "https://www.instagram.com/lifeisshorj/" },
      { label: "shorj.com", href: "https://shorj.com/" },
    ],
  },
];
---

<footer class="bg-border">
  <div class="mx-auto w-full max-w-[1920px] px-5 pt-12 pb-8 text-sm sm:px-8 lg:px-12 xl:px-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto]">
      <div class="max-w-95">
        <a
          href="/"
          aria-label={`${site.name} home`}
          class="inline-block rounded-full transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          <img
            src="/logo-512.png"
            alt=""
            width="40"
            height="40"
            loading="lazy"
            class="size-10 rounded-full"
          />
        </a>

        <SubscribeForm client:load className="mt-6" />

        <p class="mt-4 text-pretty text-muted-foreground">
          Honest reviews of cafés, stays, and experiences around Bali, from our
          own visits. Subscribe to get each new review by email.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:gap-x-16">
        {columns.map(({ title, links }) => (
          <div>
            <h2 class="text-muted-foreground">{title}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {links.map(({ label, href, action }) => {
                const external = href.startsWith("http");

                return (
                  <li>
                    <a
                      href={href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noopener noreferrer" : undefined}
                      data-action={action}
                      data-placement={action && "footer"}
                      class="transition-colors hover:text-muted-foreground focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
                    >
                      {label}
                      {external && (
                        <span class="sr-only"> (opens in a new tab)</span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <p class="mt-12 text-muted-foreground">
      &copy; {`${currentYear} ${site.name}`}
    </p>
  </div>
</footer>
