---
import type { ComponentProps } from "astro/types";
import JsonLd from "@/seo/JsonLd.astro";
import SEO from "@/seo/SEO.astro";
import PostHog from "@/analytics/posthog.astro";
import WebsiteActions from "@/analytics/WebsiteActions.astro";
import "@/design-system/global.css";

import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { site } from "./site";

type Props = ComponentProps<typeof SEO> & {
  header?: boolean;
  footer?: boolean;
  /** Footer email form. Off on the post-confirmation page. */
  subscribe?: boolean;
  jsonLd?: ComponentProps<typeof JsonLd>["schema"];
  /** Stable analytics id; keep it if the page URL changes. */
  analyticsPageId?: string;
};

const {
  header = true,
  footer = true,
  subscribe = true,
  jsonLd,
  analyticsPageId,
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...seo} />
    {jsonLd && <JsonLd schema={jsonLd} />}
    <PostHog pageId={analyticsPageId} />
  </head>
  <body class="flex min-h-dvh flex-col">
    {header && <Header />}
    <slot />
    {footer && <Footer subscribe={subscribe} />}
    {!analyticsPageId && <WebsiteActions />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
