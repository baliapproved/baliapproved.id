---
import type { ComponentProps } from "astro/types";
import SEO from "@/seo/SEO.astro";
import PostHog from "@/analytics/posthog.astro";
import WebsiteActions from "@/analytics/WebsiteActions.astro";
import "@/design-system/global.css";

import { site } from "./site";

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

type Props = ComponentProps<typeof SEO> & {
  jsonLd?: JsonLd;
  /** Stable analytics id; keep it if the page URL changes. */
  analyticsPageId?: string;
};

const { jsonLd, analyticsPageId, ...seo } = Astro.props;
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Runs before first paint so the theme never flashes. */}
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const applyThemePreference = () => {
        const isDark = getThemePreference() === "dark";
        document.documentElement.classList[isDark ? "add" : "remove"]("dark");
      };

      applyThemePreference();

      // Only takes effect while no explicit choice is stored, so the OS
      // switching themes is followed live without overriding the user.
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", applyThemePreference);
    </script>
    <SEO {...seo} />
    {serializedJsonLd && (
      <script
        type="application/ld+json"
        set:html={serializedJsonLd}
        is:inline
      />
    )}
    <PostHog pageId={analyticsPageId} />
  </head>
  <body>
    <slot />
    <WebsiteActions />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
