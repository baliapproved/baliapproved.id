---
import { RiCloseLine, RiMenu2Line, RiSearchLine } from "@remixicon/react";
import { cn } from "cn";
import { buttonVariants } from "@/design-system/button";
import { site } from "./site";

const links = [
  { label: "Discover", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "About", href: "/about" },
];
---

<header class="group/header bg-border">
  <div class="mx-auto grid w-full max-w-[1920px] grid-cols-[1fr_auto] items-center gap-2 px-5 py-5 sm:grid-cols-[1fr_auto_1fr] sm:px-8 sm:py-6 lg:px-12 xl:px-20">
    <a
      href="/"
      aria-label={`${site.name} home`}
      class="grid size-11 place-items-center justify-self-start rounded-full transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
    >
      <svg
        viewBox="0 0 64 64"
        fill="none"
        class="size-10 overflow-visible"
        aria-hidden="true"
      >
        <defs>
          <path
            id="brand-mark-petal"
            d="M32 30C18 29 11 25 12 17C13 9 22 5 29 11C34 15 35 22 32 30Z"
          />
          <filter
            id="brand-mark-glow"
            x="-40%"
            y="-40%"
            width="180%"
            height="180%"
          >
            <feDropShadow
              dx="0"
              dy="0"
              stdDeviation="1.2"
              flood-color="#2cd88a"
            />
            <feDropShadow
              dx="0"
              dy="0"
              stdDeviation="3"
              flood-color="#2cd88a"
              flood-opacity="0.7"
            />
          </filter>
        </defs>
        <g
          fill="#000"
          stroke="#42e89a"
          stroke-width="0.8"
          filter="url(#brand-mark-glow)"
        >
          <use href="#brand-mark-petal" />
          <use href="#brand-mark-petal" transform="rotate(90 32 32)" />
          <use href="#brand-mark-petal" transform="rotate(180 32 32)" />
          <use href="#brand-mark-petal" transform="rotate(270 32 32)" />
        </g>
      </svg>
    </a>

    <nav aria-label="Primary" class="hidden sm:block">
      <ul class="flex items-center gap-0.5 sm:gap-1">
        {links.map(({ label, href }) => {
          const active = Astro.url.pathname === href;

          return (
            <li>
              <a
                href={href}
                aria-current={active ? "page" : undefined}
                class={cn(
                  "inline-flex min-h-11 items-center rounded-full px-4 text-base font-medium text-foreground/65 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring",
                  active
                    ? "bg-background text-foreground"
                    : "hover:bg-foreground/5",
                )}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2.5 justify-self-end">
      <button
        type="button"
        aria-label="Search"
        class={cn(
          buttonVariants({ variant: "outline", size: "icon-lg" }),
          "min-h-11 min-w-11 rounded-full",
        )}
      >
        <RiSearchLine aria-hidden="true" />
      </button>
      <button
        type="button"
        aria-label="Menu"
        popovertarget="mobile-nav"
        class={cn(
          buttonVariants({ variant: "outline", size: "icon-lg" }),
          "min-h-11 min-w-11 rounded-full sm:hidden",
        )}
      >
        <RiMenu2Line
          aria-hidden="true"
          className="group-has-[#mobile-nav:popover-open]/header:hidden"
        />
        <RiCloseLine
          aria-hidden="true"
          className="hidden size-5 group-has-[#mobile-nav:popover-open]/header:block"
        />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    popover
    aria-label="Primary"
    class="absolute inset-x-3 top-21 m-0 w-auto -translate-y-1 rounded-3xl border-0 bg-popover p-2 text-popover-foreground opacity-0 shadow-lg transition-[opacity,translate,display,overlay] transition-discrete duration-150 ease-out backdrop:bg-black/10 open:translate-y-0 open:opacity-100 motion-reduce:transition-none sm:hidden starting:open:-translate-y-1 starting:open:opacity-0"
  >
    <ul class="flex flex-col">
      {links.map(({ label, href }) => {
        const active = Astro.url.pathname === href;

        return (
          <li>
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class={cn(
                "flex min-h-12 items-center rounded-2xl px-4 text-lg font-medium text-foreground/65 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring",
                active ? "bg-muted text-foreground" : "hover:bg-muted",
              )}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
