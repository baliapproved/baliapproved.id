---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { RiArrowRightUpLine } from "@remixicon/react";
import { Card, CardContent } from "@/design-system/card";
import { formatSpending } from "@/places/spending";
import PlaceBadge from "./PlaceBadge.astro";

interface Props {
  place: CollectionEntry<"places">;
}
const { data } = Astro.props.place;
---

<Card
  size="sm"
  className="relative h-full gap-2 rounded-3xl pt-8 pb-3 shadow-none ring-0 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring sm:pt-6 sm:pb-4"
>
  <CardContent className="px-3 sm:px-4">
    <Image
      src={data.cutout.src}
      alt={data.cutout.alt}
      widths={[440, 660, 880]}
      sizes="(min-width: 1024px) 33vw, (min-width: 360px) 50vw, 100vw"
      class="mx-auto aspect-7/6 w-5/6 object-contain p-1 motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover/card:scale-[1.02] sm:p-5"
    />
  </CardContent>
  <div class="absolute inset-x-3 top-3 flex items-start text-xs sm:inset-x-4 sm:top-4 sm:text-sm">
    {data.badge && <PlaceBadge badge={data.badge} />}
    <span class="ml-auto hidden size-9 place-items-center rounded-full bg-muted text-foreground/65 transition-colors group-hover/card:text-foreground sm:grid">
      <RiArrowRightUpLine aria-hidden="true" className="size-5" />
    </span>
  </div>
  <CardContent className="flex flex-col gap-1 px-3 sm:px-4">
    <h3 class="font-medium wrap-break-word sm:order-2">
      <a
        href={`/places/${data.slug}`}
        class="outline-none after:absolute after:inset-0"
      >
        {data.title}
      </a>
    </h3>
    <p class="flex flex-col text-xs text-muted-foreground sm:order-1 sm:block sm:text-sm">
      <span>{data.area}</span>
      {data.spending && (
        <>
          <span aria-hidden="true" class="hidden sm:inline">
            {" "}
            ·{" "}
          </span>
          <span class="whitespace-nowrap">{formatSpending(data.spending)}</span>
        </>
      )}
    </p>
  </CardContent>
</Card>
