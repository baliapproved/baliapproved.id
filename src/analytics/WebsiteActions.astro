---
// Sends one website_action per click on a link marked with data-action and
// data-placement. Each site lists its actions, placements, and extra
// breakdowns in ./actions.ts. Layout leaves it out of pages with their own
// analytics id, which record their own events.
---

<script>
  import { actions, breakdowns, placements } from "./actions";

  interface PostHog {
    capture(
      event: string,
      properties: Record<string, unknown>,
      options: { transport: "sendBeacon"; send_instantly: boolean },
    ): void;
  }

  interface Breakdown {
    key: string;
    label: string;
    /** data-* key holding the value id. */
    id: string;
    /** data-* key holding the display name, or display names by value id. */
    name: string | Record<string, string>;
  }

  const extraBreakdowns: Breakdown[] = breakdowns;

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("a[data-action]");
    if (!link) return;
    const { action, placement } = link.dataset;
    if (!action || !placement || !actions[action] || !placements[placement]) {
      return;
    }

    // Extra breakdowns go first and only when the link carries them.
    const extra = extraBreakdowns.flatMap(({ key, label, id, name }) => {
      const valueId = link.dataset[id];
      const valueName =
        typeof name === "string"
          ? link.dataset[name]
          : valueId && name[valueId];
      return valueId && valueName
        ? [{ key, label, value_id: valueId, value_name: valueName }]
        : [];
    });

    // Send right away: the click may leave the page or open another app.
    (window as Window & { posthog?: PostHog }).posthog?.capture(
      "website_action",
      {
        action_id: action,
        action_name: actions[action],
        breakdowns: [
          ...extra,
          {
            key: "placement",
            label: "Placement",
            value_id: placement,
            value_name: placements[placement],
          },
        ],
      },
      { transport: "sendBeacon", send_instantly: true },
    );
  });
</script>
