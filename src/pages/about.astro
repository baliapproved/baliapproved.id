---
import { Image } from "astro:assets";
import { buttonVariants } from "@/design-system/button";
import teamPhoto from "@/site/assets/team.webp";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";
---

<Layout title={`About | ${site.name}`} indexable={false}>
  <main class="flex-1 bg-border">
    <article class="mx-auto w-full max-w-150 px-5 pt-6 pb-12 sm:pt-10">
      <Image
        src={teamPhoto}
        alt="The team behind Bali Approved, smiling under a café's woven balcony"
        widths={[640, 1280]}
        sizes="(min-width: 600px) 560px, calc(100vw - 40px)"
        loading="eager"
        class="aspect-4/3 w-full rounded-3xl object-cover object-[center_72%] sm:aspect-16/7"
      />

      <h1 class="mt-8 text-4xl/10 font-medium tracking-tight text-balance">
        We moved to Bali and started writing down everything we tried
      </h1>

      <p class="mt-4 text-base/6 text-pretty text-muted-foreground">
        The more we explored, the more we found worth remembering, so we kept a
        record. Bali Approved is that record. Every café, stay, and experience
        here is one we tried ourselves, with our own photos and an honest take
        on how it went. It’s mostly for us to look back on, and we hope it helps
        you find your next spot too.
      </p>

      <section aria-labelledby="work-with-us" class="mt-12">
        <h2 id="work-with-us" class="text-2xl font-medium tracking-tight">
          Work with us
        </h2>
        <p class="mt-2 text-base/6 text-pretty text-muted-foreground">
          Run a café, stay, or experience in Bali and want us to come by? Tell
          us what makes it worth a visit.
        </p>
        <a
          href={`https://wa.me/6285117325144?text=${encodeURIComponent("Halo Bali Approved, saya ingin membicarakan kerja sama.")}`}
          target="_blank"
          rel="noopener noreferrer"
          data-action="collaboration_click"
          data-placement="about"
          class:list={[buttonVariants({ size: "lg" }), "mt-4 w-full sm:w-auto"]}
        >
          Message us on WhatsApp
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </section>
    </article>
  </main>
</Layout>
