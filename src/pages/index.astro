---
import { getCollection } from "astro:content";
import Catalog from "@/catalog/Catalog.astro";
import Hero from "@/hero/Hero.astro";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";

const places = (await getCollection("places")).sort(
  (a, b) =>
    (b.data.lastVisitedAt?.getTime() ?? 0) -
    (a.data.lastVisitedAt?.getTime() ?? 0),
);
---

<Layout
  title={site.title}
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        name: site.name,
        url: site.url,
        publisher: { "@id": `${site.url}/#organization` },
      },
      {
        "@type": "Organization",
        "@id": `${site.url}/#organization`,
        name: site.name,
        url: site.url,
        // The BA seal.
        logo: `${site.url}/apple-touch-icon.png`,
        sameAs: ["https://www.instagram.com/bali.approved/"],
      },
    ],
  }}
>
  <main class="flex-1 bg-border">
    <Hero />
    <Catalog places={places} />
  </main>
</Layout>
