---
import Layout from "@/site/Layout.astro";
import Footer from "@/site/Footer.astro";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "@/site/site";
import { DaysAgo } from "@/design-system/DaysAgo";
import { ModeToggle } from "@/site/ModeToggle";
import { buttonVariants } from "@/design-system/button";
import { cn } from "@/design-system/utils";
import teamPhoto from "@/site/assets/team.webp";
import { Seal } from "@/places/Seal";

const siteUrl = new URL("/", Astro.site ?? site.url);
const organizationId = new URL("#organization", siteUrl).href;
const websiteId = new URL("#website", siteUrl).href;
const webpageId = new URL("#webpage", siteUrl).href;
const placesListId = new URL("#approved-places", siteUrl).href;

const places = (await getCollection("places")).sort(
  (a, b) => a.data.approvalNumber - b.data.approvalNumber,
);

const getPlaceUrl = (placeId: string) => new URL(`/places/${placeId}`, siteUrl);
const getBusinessId = (placeId: string) =>
  new URL("#business", getPlaceUrl(placeId)).href;
const getReviewId = (placeId: string) =>
  new URL("#review", getPlaceUrl(placeId)).href;

const schemaImageUrls = new Map(
  await Promise.all(
    places.map(async (place) => {
      const cover = await getImage({
        src: place.data.cover,
        width: 1280,
        format: "webp",
      });

      return [place.id, new URL(cover.src, siteUrl).href] as const;
    }),
  ),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl.href,
      name: site.name,
      alternateName: "baliapproved.id",
      description: site.description,
      inLanguage: site.language,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      url: siteUrl.href,
      name: site.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo-512.png", siteUrl).href,
        width: 512,
        height: 512,
      },
      sameAs: ["https://www.instagram.com/bali.approved/"],
    },
    {
      "@type": "CollectionPage",
      "@id": webpageId,
      url: siteUrl.href,
      name: site.title,
      description: site.description,
      inLanguage: site.language,
      isPartOf: { "@id": websiteId },
      about: places.map((place) => ({
        "@id": getBusinessId(place.id),
      })),
      mainEntity: { "@id": placesListId },
    },
    {
      "@type": "ItemList",
      "@id": placesListId,
      name: "Bali Approved places",
      numberOfItems: places.length,
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: places.map((place, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@id": getBusinessId(place.id),
        },
      })),
    },
    ...places.flatMap((place) => {
      const placeUrl = getPlaceUrl(place.id).href;
      const businessId = getBusinessId(place.id);
      const reviewId = getReviewId(place.id);
      const schemaImageUrl = schemaImageUrls.get(place.id);

      if (!schemaImageUrl) {
        throw new Error(`Schema image is missing for ${place.id}.`);
      }

      return [
        {
          "@type": "CafeOrCoffeeShop",
          "@id": businessId,
          name: place.data.title,
          url: placeUrl,
          sameAs: place.data.mapsUrl,
          image: schemaImageUrl,
          priceRange: place.data.spending,
          review: { "@id": reviewId },
          address: place.data.address,
        },
        {
          "@type": "Review",
          "@id": reviewId,
          url: placeUrl,
          name: `${place.data.title} review`,
          reviewBody: place.data.description,
          datePublished: place.data.approvedAt.toISOString().slice(0, 10),
          author: { "@id": organizationId },
          publisher: { "@id": organizationId },
          itemReviewed: { "@id": businessId },
          reviewRating: {
            "@type": "Rating",
            ratingValue: place.data.overallRating,
            bestRating: 5,
            worstRating: 1,
          },
        },
      ];
    }),
  ],
};

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={site.title} jsonLd={jsonLd}>
  <main class="min-h-[100dvh] bg-site-canvas">
    <section class="mx-auto flex w-full max-w-xl flex-col px-6 py-6 sm:py-8">
      <div class="flex justify-center">
        <ModeToggle client:load />
      </div>

      <Image
        src={teamPhoto}
        alt="The three of us behind Bali Approved"
        widths={[576, 1080]}
        sizes="(min-width: 640px) 576px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-6 aspect-5/4 w-full object-cover"
      />

      <h1 class="mt-8 text-xl leading-tight tracking-tight sm:text-3xl">
        Hi, we are the team behind baliapproved.id.
      </h1>

      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        We moved to Bali <DaysAgo client:load since="2026-08-09" />. As we
        started exploring, we found so many interesting places that we wanted a
        way to remember them, document them, and appreciate each experience for
        what it was. Bali Approved is our record of the places we've actually
        visited and our honest experience of them. Hopefully, it becomes
        something useful for us to look back on in the future, and perhaps
        useful for you too.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#places" class={cn(buttonVariants({ size: "lg" }))}>
          See the places
        </a>
        <a
          href={`https://wa.me/6285117325144?text=${encodeURIComponent("Halo Bali Approved, saya ingin membicarakan kerja sama.")}`}
          class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
          data-action="collaboration_click"
          data-placement="hero"
        >
          Collaborate with us
        </a>
      </div>
    </section>
    <section
      id="places"
      aria-labelledby="places-heading"
      class="scroll-mt-6 pt-14 sm:pt-18 lg:pt-24"
    >
      <h2 id="places-heading" class="sr-only">
        Places
      </h2>

      <ol class="list-none p-0">
        {places.map((place, index) => {
          const { data } = place;
          const reversed = index % 2 === 1;
          const approvedDate = dateFormatter.format(data.approvedAt);

          return (
            <li
              class:list={[
                "px-6 py-16 sm:px-8 sm:py-20 lg:py-28",
                index % 2 === 0 ? "bg-site-panel" : "bg-site-canvas",
              ]}
            >
              <article
                aria-labelledby={`${place.id}-listing-title`}
                class="mx-auto grid w-full max-w-6xl items-center gap-x-12 lg:grid-cols-12 xl:gap-x-18"
              >
                <div
                  class:list={[
                    "relative lg:col-span-7",
                    { "lg:order-2": reversed },
                  ]}
                >
                  <a
                    href={`/places/${place.id}`}
                    aria-label={`See why we approved ${data.title}`}
                    class="group block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#006241]"
                  >
                    <Image
                      src={data.cover}
                      alt={data.coverAlt}
                      widths={[640, 960, 1280]}
                      sizes="(min-width: 1152px) 664px, (min-width: 1024px) 58vw, calc(100vw - 48px)"
                      loading="lazy"
                      class="aspect-5/4 w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.015] motion-safe:group-focus-visible:scale-[1.015] sm:aspect-4/3 lg:aspect-6/5"
                    />
                  </a>

                  <div
                    class:list={[
                      "absolute right-4 bottom-0 z-10 translate-y-[34%] sm:right-7",
                      { "lg:right-auto lg:left-7": reversed },
                    ]}
                  >
                    <Seal
                      number={data.approvalNumber}
                      area={data.sealArea}
                      year={data.approvedAt.getUTCFullYear()}
                      size={142}
                      className="bg-[#006241] [&_svg_text]:fill-white/80 [&>span]:text-white"
                    />
                  </div>
                </div>

                <div
                  class:list={[
                    "pt-20 lg:col-span-5 lg:pt-0",
                    { "lg:order-1": reversed },
                  ]}
                >
                  <p class="flex flex-wrap items-center gap-x-2 text-sm font-medium text-muted-foreground">
                    <span class="text-foreground">{data.sealArea}</span>
                    <span aria-hidden="true">·</span>
                    <span>
                      Approved{" "}
                      <time datetime={data.approvedAt.toISOString()}>
                        {approvedDate}
                      </time>
                    </span>
                  </p>

                  <h3
                    id={`${place.id}-listing-title`}
                    class="mt-4 text-[clamp(2.25rem,4.5vw,4.5rem)] leading-[0.95] tracking-[-0.04em] text-balance"
                  >
                    <a
                      href={`/places/${place.id}`}
                      class="transition-colors hover:text-[#006241] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#006241]"
                    >
                      {data.title}
                    </a>
                  </h3>

                  <p class="mt-5 max-w-xl font-heading text-xl leading-relaxed tracking-[-0.01em] text-pretty sm:text-2xl">
                    {data.description}
                  </p>

                  <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
                    <div>
                      <dt class="text-[0.625rem] font-semibold tracking-[0.18em] text-muted-foreground uppercase">
                        Overall
                      </dt>
                      <dd class="mt-1.5 flex items-baseline gap-1.5 font-heading text-2xl tracking-tight">
                        <span
                          aria-hidden="true"
                          class="text-base text-[#d49b20]"
                        >
                          ★
                        </span>
                        <span>{data.overallRating.toFixed(1)} / 5</span>
                      </dd>
                    </div>

                    <div>
                      <dt class="text-[0.625rem] font-semibold tracking-[0.18em] text-muted-foreground uppercase">
                        Spending
                      </dt>
                      <dd class="mt-1.5 font-heading text-xl tracking-tight">
                        {data.spending}
                      </dd>
                    </div>
                  </dl>

                  <div class="mt-8">
                    <a
                      href={`/places/${place.id}`}
                      class="group inline-flex w-full items-center justify-between gap-6 rounded-sm bg-[#006241] px-5 py-3.5 text-sm font-semibold tracking-[0.04em] text-white transition-colors hover:bg-[#004d33] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#006241] sm:w-auto"
                    >
                      <span>See why we approved it</span>
                      <span
                        aria-hidden="true"
                        class="motion-safe:transition-transform motion-safe:group-hover:translate-x-1 motion-safe:group-focus-visible:translate-x-1"
                      >
                        →
                      </span>
                    </a>
                  </div>

                  <a
                    href={data.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-action="maps_click"
                    data-placement="place_listing"
                    data-place-id={place.id}
                    data-place-name={data.title}
                    class="mt-6 inline-flex max-w-xl items-start text-sm leading-relaxed text-muted-foreground decoration-foreground/35 underline-offset-4 hover:text-foreground hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#006241]"
                  >
                    <span>
                      <span aria-hidden="true">📍</span>
                      {"\u00A0"}
                      {data.address}
                    </span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </section>
  </main>
  <Footer />
</Layout>
