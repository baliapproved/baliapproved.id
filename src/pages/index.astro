---
import type { Graph } from "schema-dts";
import Layout from "@/site/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "@/site/site";
import { DaysAgo } from "@/design-system/DaysAgo";
import { buttonVariants } from "@/design-system/button";
import { cn } from "@/design-system/utils";
import teamPhoto from "@/site/assets/team.webp";
import PlaceList from "@/places/PlaceList.astro";

const siteUrl = new URL("/", Astro.site ?? site.url);
const organizationId = new URL("#organization", siteUrl).href;
const websiteId = new URL("#website", siteUrl).href;

const places = (await getCollection("places")).sort(
  (a, b) => a.data.approvalNumber - b.data.approvalNumber,
);

const jsonLd: Graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl.href,
      name: site.name,
      alternateName: "baliapproved.id",
      description: site.description,
      inLanguage: site.language,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      url: siteUrl.href,
      name: site.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo-512.png", siteUrl).href,
      },
      sameAs: ["https://www.instagram.com/bali.approved/"],
    },
  ],
};
---

<Layout title={site.title} jsonLd={jsonLd}>
  <main class="min-h-[100dvh] bg-background">
    <section class="mx-auto flex w-full max-w-xl flex-col px-6 py-6 sm:py-8">
      <Image
        src={teamPhoto}
        alt="The three of us behind Bali Approved"
        widths={[576, 1080]}
        sizes="(min-width: 640px) 576px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-5/4 w-full object-cover"
      />

      <h1 class="mt-8 text-xl leading-tight tracking-tight sm:text-3xl">
        Hi, we are the team behind baliapproved.id.
      </h1>

      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        We moved to Bali <DaysAgo client:load since="2026-08-09" />. As we
        started exploring, we found so many interesting places that we wanted a
        way to remember them, document them, and appreciate each experience for
        what it was. Bali Approved is our record of the places we've actually
        visited and our honest experience of them. Hopefully, it becomes
        something useful for us to look back on in the future, and perhaps
        useful for you too.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#places" class={cn(buttonVariants({ size: "lg" }))}>
          See the places
        </a>
        <a
          href={`https://wa.me/6285117325144?text=${encodeURIComponent("Halo Bali Approved, saya ingin membicarakan kerja sama.")}`}
          class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
          data-action="collaboration_click"
          data-placement="hero"
        >
          Collaborate with us
        </a>
      </div>
    </section>
    <PlaceList places={places} />
  </main>
</Layout>
