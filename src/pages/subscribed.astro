---
import { buttonVariants } from "@/design-system/button";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";
---

<Layout
  title={`You’re subscribed | ${site.name}`}
  description="New reviews of places in Bali arrive every Friday."
  indexable={false}
  subscribe={false}
>
  <main class="flex flex-1 bg-border px-5">
    <article class="mx-auto flex w-full max-w-md flex-col items-center justify-center py-16 text-center sm:py-24">
      <svg
        aria-hidden="true"
        viewBox="0 0 180 136"
        fill="none"
        class="subscribed-mark h-32 w-44 sm:h-36 sm:w-52"
      >
        <g
          transform="rotate(-7 90 68)"
          stroke="#795449"
          stroke-width="1.2"
          stroke-linejoin="round"
        >
          <path
            d="M22 58 86 17a7 7 0 0 1 8 0l64 41v55H22Z"
            fill="#DF8B73"
          ></path>
          <rect
            x="40"
            y="25"
            width="100"
            height="82"
            rx="2"
            fill="#FFF8EB"
          ></rect>
          <path
            d="M51 42h39m-39 8h27m-27 16h59m-59 8h47"
            stroke="#B6A795"
          ></path>
          <path d="M116 33h16v21h-16z" fill="#CB654C" stroke="none"></path>
          <circle
            cx="124"
            cy="43.5"
            r="4"
            fill="#FFF8EB"
            stroke="none"
          ></circle>
          <path
            d="m22 58 68 44 68-44v55a4 4 0 0 1-4 4H26a4 4 0 0 1-4-4Z"
            fill="#EEAF99"
          ></path>
          <path d="m24 115 44-27m88 27-44-27"></path>
        </g>
      </svg>

      <h1 class="mt-8 text-4xl/10 font-medium tracking-tight text-balance">
        You’re subscribed
      </h1>

      <p class="mt-3 text-base/6 text-pretty text-foreground/65">
        New reviews arrive every Friday, from the cafés, stays, and experiences
        we’ve tried.
      </p>

      <a
        href="/"
        class:list={[buttonVariants({ size: "lg" }), "mt-8 w-full sm:w-auto"]}
      >
        See the places
      </a>

      <p class="mt-4 text-sm text-pretty text-muted-foreground">
        Changed your mind? Unsubscribe from any review we send.
      </p>
    </article>
  </main>
</Layout>

<style>
  .subscribed-mark {
    animation: subscribed-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes subscribed-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subscribed-mark {
      animation: none;
    }
  }
</style>
