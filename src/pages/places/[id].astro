---
import { getImage, Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import type {
  CafeOrCoffeeShop,
  LodgingBusiness,
  NightClub,
  Restaurant,
  WithContext,
} from "schema-dts";
import {
  RiArmchairFill,
  RiArrowRightUpLine,
  RiCalendarCheckFill,
  RiCalendarTodoFill,
  RiCarFill,
  RiDoorOpenFill,
  RiFridgeFill,
  RiGlobalFill,
  RiHotelBedFill,
  RiInstagramFill,
  RiLifebuoyFill,
  RiMapPin2Fill,
  RiMotorbikeFill,
  RiMusic2Fill,
  RiPhoneFill,
  RiPlugFill,
  RiTempColdFill,
  RiThreadsFill,
  RiTiktokFill,
  RiVolumeDownFill,
  RiWhatsappFill,
  RiWifiFill,
} from "@remixicon/react";
import PlaceBadge from "@/catalog/PlaceBadge.astro";
import PlaceCard from "@/catalog/PlaceCard.astro";
import { buttonVariants } from "@/design-system/button";
import { PlacePhotos } from "@/places/PlacePhotos";
import { formatSpending } from "@/places/spending";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";

export async function getStaticPaths() {
  const places = (await getCollection("places")).sort(
    (a, b) =>
      (b.data.lastVisitedAt?.getTime() ?? 0) -
      (a.data.lastVisitedAt?.getTime() ?? 0),
  );

  return places.map((place) => ({
    params: { id: place.data.slug },
    props: {
      place,
      morePlaces: places.filter(({ id }) => id !== place.id).slice(0, 3),
    },
  }));
}

interface Props {
  place: CollectionEntry<"places">;
  morePlaces: CollectionEntry<"places">[];
}

const { place, morePlaces }: Props = Astro.props;
const { data } = place;
const siteUrl = new URL("/", Astro.site ?? site.url);
const socialImage =
  data.cover &&
  (await getImage({
    src: data.cover,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "webp",
  }));
const socialImageUrl = socialImage && new URL(socialImage.src, siteUrl).href;
// The first visit, so the review date stays put when we revisit.
const reviewedAt =
  data.visitedAt && new Date(Math.min(...data.visitedAt.map(Number)));
const jsonLd: WithContext<
  CafeOrCoffeeShop | Restaurant | LodgingBusiness | NightClub
> = {
  "@context": "https://schema.org",
  "@type": (
    {
      cafes: "CafeOrCoffeeShop",
      restaurants: "Restaurant",
      stays: "LodgingBusiness",
      clubs: "NightClub",
    } as const
  )[data.category],
  name: data.title,
  description: data.about,
  image: socialImageUrl ?? new URL(data.cutout.src.src, siteUrl).href,
  url: data.website,
  telephone: data.phone ?? data.whatsapp,
  priceRange: data.spending && formatSpending(data.spending),
  address: {
    "@type": "PostalAddress",
    streetAddress: data.address,
    postalCode: data.postalCode,
    addressRegion: "Bali",
    addressCountry: "ID",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: data.coordinates.lat,
    longitude: data.coordinates.lng,
  },
  hasMap: data.mapsUrl,
  sameAs: [
    `https://www.instagram.com/${data.instagram}/`,
    ...(data.threads ? [`https://www.threads.com/@${data.threads}`] : []),
    ...(data.tiktok ? [`https://www.tiktok.com/@${data.tiktok}`] : []),
  ],
  review: reviewedAt && {
    "@type": "Review",
    author: { "@type": "Organization", name: site.name, url: site.url },
    datePublished: reviewedAt.toISOString().slice(0, 10),
    reviewBody: data.description,
  },
};
const visitedDate =
  data.lastVisitedAt &&
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(data.lastVisitedAt);

const NoteIcon = data.lastVisitedAt ? RiCalendarCheckFill : RiCalendarTodoFill;

const photos = await Promise.all(
  [
    ...(data.cover ? [{ src: data.cover, alt: data.coverAlt ?? "" }] : []),
    ...data.gallery,
  ].map(async ({ src, alt }) => {
    const image = await getImage({
      src,
      widths: [360, 540, 720],
      sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 40vw, 72vw",
    });

    return {
      src: image.src,
      srcSet: image.srcSet.attribute,
      sizes: String(image.attributes.sizes),
      alt,
      width: src.width,
      height: src.height,
    };
  }),
);

const links = [
  {
    action: "instagram_click",
    label: "Follow on Instagram",
    value: `@${data.instagram}`,
    href: `https://www.instagram.com/${data.instagram}/`,
    // Platform colors, so each link is recognisable at a glance.
    tone: "bg-[#e4405f]/12 text-[#e4405f]",
    icon: RiInstagramFill,
  },
  data.threads && {
    action: "threads_click",
    label: "Follow on Threads",
    value: `@${data.threads}`,
    href: `https://www.threads.com/@${data.threads}`,
    tone: "bg-foreground/8 text-foreground",
    icon: RiThreadsFill,
  },
  data.tiktok && {
    action: "tiktok_click",
    label: "Watch on TikTok",
    value: `@${data.tiktok}`,
    href: `https://www.tiktok.com/@${data.tiktok}`,
    tone: "bg-[#25f4ee]/30 text-foreground",
    icon: RiTiktokFill,
  },
  data.website && {
    action: "website_click",
    label: "Visit website",
    value: new URL(data.website).hostname.replace(/^www\./, ""),
    href: data.website,
    tone: "bg-[#4a84c4]/12 text-[#4a84c4]",
    icon: RiGlobalFill,
  },
  data.whatsapp && {
    action: "whatsapp_click",
    label: "Chat on WhatsApp",
    value: data.whatsapp,
    href: `https://wa.me/${data.whatsapp.replace(/\D/g, "")}`,
    tone: "bg-[#1fa855]/12 text-[#1fa855]",
    icon: RiWhatsappFill,
  },
  data.phone && {
    action: "phone_click",
    label: "Call",
    value: data.phone,
    href: `tel:${data.phone.replace(/ /g, "")}`,
    tone: "bg-[#7b61c9]/12 text-[#7b61c9]",
    icon: RiPhoneFill,
  },
  {
    action: "maps_click",
    label: "Address",
    value: data.address,
    href: data.mapsUrl,
    tone: "bg-[#e8710a]/12 text-[#e8710a]",
    icon: RiMapPin2Fill,
  },
].filter((link) => !!link);

const amounts = {
  plenty: "Plenty",
  enough: "Enough",
  limited: "Limited",
  street: "Street only",
  unavailable: "Not available",
};
const cooling =
  data.cooling &&
  {
    ac: "Air-conditioned",
    fan: "Fan",
    "ac-and-fan": "AC & fan",
    "open-air": "Fan & open air",
  }[data.cooling];
// A range rather than the exact test result, which changes from test to test.
const wifiRange = (mbps: number) => {
  const step = mbps < 100 ? 10 : 50;
  const low = Math.floor(mbps / step) * step;
  return low === 0 ? "Under 10 Mbps" : `${low}–${low + step} Mbps`;
};
const seating = data.seating
  ?.map((area) =>
    area === "indoor" && data.cooling
      ? `indoor (${{ ac: "AC", fan: "fan", "ac-and-fan": "AC & fan", "open-air": "open air" }[data.cooling]})`
      : area.replace("-", " "),
  )
  .join(" & ");
const wifiFinding = data.wifi !== undefined && {
  label: "Wi-Fi",
  value:
    typeof data.wifi === "number"
      ? wifiRange(data.wifi)
      : "Available · speed not measured",
  icon: RiWifiFill,
};
const noiseFinding = data.noise && {
  label: "Noise",
  value: {
    quiet: "Quiet",
    moderate: "Moderate",
    loud: "Loud",
  }[data.noise],
  icon: RiVolumeDownFill,
};
const parkingFindings = data.parking
  ? [
      {
        label: "Motorbike parking",
        value: amounts[data.parking.motorbike],
        icon: RiMotorbikeFill,
      },
      {
        label: "Car parking",
        value: amounts[data.parking.car],
        icon: RiCarFill,
      },
    ]
  : [];
const findings = (
  data.category === "stays"
    ? [
        data.roomType && {
          label: "Room type",
          value: {
            "private-studio": "Private studio",
            "private-room": "Private room",
            "shared-dorm": "Shared dorm",
          }[data.roomType],
          icon: RiHotelBedFill,
        },
        data.bathroom && {
          label: "Bathroom",
          value: { private: "Private", shared: "Shared" }[data.bathroom],
          icon: RiDoorOpenFill,
        },
        { label: "Cooling", value: cooling, icon: RiTempColdFill },
        wifiFinding,
        noiseFinding,
        data.kitchen && {
          label: "Kitchen",
          value: {
            private: "Private",
            shared: "Shared",
            unavailable: "Not available",
          }[data.kitchen],
          icon: RiFridgeFill,
        },
        data.pool !== undefined && {
          label: "Pool",
          value: data.pool ? "Available" : "Not available",
          icon: RiLifebuoyFill,
        },
        ...parkingFindings,
      ]
    : [
        wifiFinding,
        data.power && {
          label: "Power outlets",
          value: amounts[data.power],
          icon: RiPlugFill,
        },
        seating
          ? {
              label: "Seating",
              value: seating[0].toUpperCase() + seating.slice(1),
              icon: RiArmchairFill,
            }
          : { label: "Cooling", value: cooling, icon: RiTempColdFill },
        noiseFinding,
        data.music !== undefined && {
          label: "Music",
          value:
            data.music === null
              ? "Unknown"
              : data.music
                ? "Available"
                : "Not available",
          icon: RiMusic2Fill,
        },
        data.toilet !== undefined && {
          label: "Toilet",
          value: data.toilet ? "Available" : "Not available",
          icon: RiDoorOpenFill,
        },
        data.reservation && {
          label: "Reservation",
          value: {
            "not-needed": "Not necessary",
            recommended: "Recommended",
            required: "Required",
          }[data.reservation],
          icon: RiCalendarTodoFill,
        },
        ...parkingFindings,
      ]
).filter((finding) => !!finding);
---

<Layout
  title={`${data.title} | Bali Approved`}
  description={data.description ?? data.about}
  image={socialImageUrl}
  imageAlt={data.coverAlt}
  jsonLd={jsonLd}
>
  <main class="flex-1 bg-border">
    <article class="mx-auto w-full max-w-[1920px] px-5 pt-6 pb-16 sm:px-8 sm:pt-10 lg:px-12 xl:px-20">
      <header class="flex flex-wrap items-end gap-x-8 gap-y-5">
        <div class="flex min-w-0 flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
          <Image
            src={data.cutout.src}
            alt={data.cutout.alt}
            widths={[160, 240]}
            sizes="96px"
            loading="eager"
            class="w-24 shrink-0 object-contain"
          />
          <div class="min-w-0">
            <p class="text-muted-foreground">{data.area}</p>
            <h1 class="mt-1 text-4xl/10 font-medium tracking-tight text-balance sm:text-[2.5rem]/11">
              {data.title}
            </h1>
            {data.badge && (
              <div class="mt-1">
                <PlaceBadge badge={data.badge} />
              </div>
            )}
          </div>
        </div>

        <div class="flex flex-col items-start gap-4 sm:ml-auto sm:flex-row sm:items-end sm:gap-8">
          {data.spending && (
            <p>
              <span class="block text-sm text-muted-foreground">Spending</span>
              <span class="block font-medium">
                {formatSpending(data.spending)} /{" "}
                {data.category === "stays" ? "night" : "person"}
              </span>
            </p>
          )}
          <a
            href={data.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-action="maps_click"
            data-placement="place_review"
            data-place-id={place.id}
            data-place-name={data.title}
            class={buttonVariants({ size: "lg" })}
          >
            Open in Maps
            <RiArrowRightUpLine aria-hidden="true" data-icon="inline-end" />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </header>

      {photos.length > 0 && (
        <div class="mt-6">
          <PlacePhotos
            client:load
            photos={photos}
            label={`Photos of ${data.title}`}
          />
        </div>
      )}

      <section aria-labelledby="about" class="mt-12">
        <h2 id="about" class="text-2xl font-medium tracking-tight">
          About
        </h2>
        <p class="mt-3 max-w-[34rem] text-base/7 text-pretty text-muted-foreground">
          {data.about}
        </p>

        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {links.map(({ action, label, value, href, icon: Icon, tone }) => {
            const external = href.startsWith("http");
            return (
              <li>
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  data-action={action}
                  data-placement="place_review"
                  data-place-id={place.id}
                  data-place-name={data.title}
                  class="group flex h-full items-center gap-3 rounded-3xl bg-card p-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                  <span
                    class:list={[
                      "grid size-10 shrink-0 place-items-center rounded-full motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:-rotate-6 motion-safe:group-hover:scale-105",
                      tone,
                    ]}
                  >
                    <Icon aria-hidden="true" className="size-5" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm text-muted-foreground">
                      {label}
                    </span>
                    <span class="block font-medium text-pretty break-words">
                      {value}
                    </span>
                  </span>
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-muted text-foreground/65 transition-colors group-hover:text-foreground">
                    <RiArrowRightUpLine aria-hidden="true" className="size-5" />
                  </span>
                  {external && (
                    <span class="sr-only"> (opens in a new tab)</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="our-review" class="mt-12 max-w-[34rem]">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 id="our-review" class="text-2xl font-medium tracking-tight">
            Our review
          </h2>
          {data.badge && <PlaceBadge badge={data.badge} />}
        </div>
        {data.description && (
          <p class="mt-3 text-base/7 text-pretty text-muted-foreground">
            {data.description}
          </p>
        )}
        <div class="relative mt-6 overflow-hidden rounded-2xl border border-[#2a8c8c]/15 bg-[#2a8c8c]/8 p-1 lg:w-[38rem]">
          <NoteIcon
            aria-hidden="true"
            className="pointer-events-none absolute -right-5 -bottom-8 size-32 -rotate-12 text-[#2a8c8c]/10"
          />
          <div class="relative flex gap-3 rounded-xl border border-[#2a8c8c]/25 px-4 py-3">
            <NoteIcon
              aria-hidden="true"
              className="mt-0.5 size-5 shrink-0 text-[#2a8c8c]"
            />
            {data.lastVisitedAt ? (
              <div>
                <p class="italic">
                  Last visited on{" "}
                  <time
                    datetime={data.lastVisitedAt.toISOString()}
                    class="font-medium"
                  >
                    {visitedDate}
                  </time>
                </p>
                <p class="mt-1 text-sm text-pretty text-muted-foreground">
                  {data.category === "cafes"
                    ? "Our review comes from our own visit."
                    : "Everything here comes from our own visit."}{" "}
                  Places might change, so check their socials for the latest
                  updates.
                </p>
              </div>
            ) : (
              <div>
                <p class="font-medium italic">Not visited yet</p>
                <p class="mt-1 text-sm text-pretty text-muted-foreground">
                  We'll add our review and photos after our visit. Until then,
                  check their socials for the latest updates.
                </p>
              </div>
            )}
          </div>
        </div>
      </section>

      {data.lastVisitedAt && (
        <section aria-labelledby="what-we-found" class="mt-12">
          <h2 id="what-we-found" class="text-2xl font-medium tracking-tight">
            What we found
          </h2>
          <p class="mt-3 max-w-[34rem] text-base/7 text-pretty text-muted-foreground">
            <span class="font-semibold text-foreground italic">
              Worth knowing
            </span>{" "}
            {data.caveats}
          </p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {findings.map(({ label, value, icon: Icon }) => (
              <li class="flex h-full items-center gap-3 rounded-3xl bg-card p-3">
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#2a8c8c]/12 text-[#2a8c8c]">
                  <Icon aria-hidden="true" className="size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm text-muted-foreground">
                    {label}
                  </span>
                  <span class="block font-medium">{value}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <section
      aria-labelledby="more-places"
      class="mx-auto w-full max-w-[1920px] px-5 pb-12 sm:px-8 lg:px-12 xl:px-20"
    >
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="more-places" class="text-2xl font-medium tracking-tight">
          More places
        </h2>
        <a
          href="/"
          class="text-muted-foreground transition-colors hover:text-foreground focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          See all
        </a>
      </div>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {morePlaces.map((place) => (
          <li>
            <PlaceCard place={place} />
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
