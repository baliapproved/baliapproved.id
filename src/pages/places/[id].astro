---
import { getImage } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";

export async function getStaticPaths() {
  const places = await getCollection("places");

  return places.map((place) => ({
    params: { id: place.data.slug },
    props: { place },
  }));
}

interface Props {
  place: CollectionEntry<"places">;
}

const { place }: Props = Astro.props;
const { data } = place;
const siteUrl = new URL("/", Astro.site ?? site.url);
const socialImage = await getImage({
  src: data.cover,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
});
const socialImageUrl = new URL(socialImage.src, siteUrl).href;
---

<Layout
  title={`${data.title} | Bali Approved`}
  description={data.description}
  image={socialImageUrl}
  imageAlt={data.coverAlt}
>
  <main class="flex-1 bg-border" />
</Layout>
