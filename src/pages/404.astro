---
import { buttonVariants } from "@/design-system/button";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";

export const prerender = true;

Astro.response.status = 404;
---

<Layout
  title={`Page not found | ${site.name}`}
  description="We couldn’t find this page. Explore cafés, stays, and experiences we’ve tried in Bali."
  indexable={false}
>
  <main class="flex flex-1 bg-border px-5">
    <article class="mx-auto flex w-full max-w-md flex-col items-center justify-center py-16 text-center sm:py-24">
      <svg
        aria-hidden="true"
        viewBox="0 0 180 136"
        fill="none"
        class="not-found-mark h-32 w-44 sm:h-36 sm:w-52"
      >
        <g
          transform="rotate(-7 90 68)"
          stroke="#795449"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="m22 42 45-13 45 13 46-13v84l-46 13-45-13-45 13Z"
            fill="#FFF8EB"
          ></path>
          <path d="m67 29 45 13v84l-45-13Z" fill="#EEAF99" stroke="none"></path>
          <path
            d="m112 42 46-13v84l-46 13Z"
            fill="#F5D5BC"
            stroke="none"
          ></path>
          <path
            d="m23 65 22 5 22-15 25 16 20-7 22 13 24-7M42 37l6 16-10 28 12 37m28-86 3 18 13 8-8 27 10 36m43-87-7 19 10 22-13 21 7 21"
            stroke="#FFF8EB"
            stroke-width="4"
          ></path>
          <path d="m67 29 0 84m45-71v84" stroke="#B6A795"></path>
          <path d="m22 42 45-13 45 13 46-13v84l-46 13-45-13-45 13Z"></path>
          <path
            d="M38 101c10-22 19-6 31-15s7-22 22-22 6 34 24 29c9-3 11-13 18-16"
            stroke-dasharray="3 4"
          ></path>
          <circle cx="38" cy="101" r="3" fill="#FFF8EB"></circle>
          <ellipse
            cx="137"
            cy="68"
            rx="9"
            ry="3"
            fill="#795449"
            opacity="0.12"
            stroke="none"
          ></ellipse>
          <path
            d="M137 17c-10 0-18 7.7-18 17.5C119 48 137 64 137 64s18-16 18-29.5c0-9.8-8-17.5-18-17.5Z"
            fill="#DF8B73"
          ></path>
          <circle cx="137" cy="34.5" r="6" fill="#FFF8EB"></circle>
        </g>
      </svg>

      <h1 class="mt-8 text-4xl/10 font-medium tracking-tight text-balance">
        We couldn’t find this page
      </h1>

      <p class="mt-3 text-base/6 text-pretty text-foreground/65">
        Head back to explore cafés, stays, and experiences we’ve tried in Bali.
      </p>

      <a
        href="/"
        class:list={[buttonVariants({ size: "lg" }), "mt-8 w-full sm:w-auto"]}
      >
        Explore the places
      </a>
    </article>
  </main>
</Layout>

<style>
  .not-found-mark {
    animation: not-found-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes not-found-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-mark {
      animation: none;
    }
  }
</style>
