---
import { buttonVariants } from "@/design-system/button";
import Layout from "@/site/Layout.astro";
import { site } from "@/site/site";

export const prerender = true;

Astro.response.status = 404;
---

<Layout
  title={`Page not found | ${site.name}`}
  description="This page isn’t on the list. Head home to browse places we’ve actually visited."
  indexable={false}
>
  <main class="flex flex-1 bg-border px-5">
    <article class="mx-auto flex w-full max-w-md flex-col items-center justify-center py-16 text-center sm:py-24">
      <svg
        aria-hidden="true"
        viewBox="0 0 180 148"
        fill="none"
        class="not-found-mark h-32 w-40 sm:h-36 sm:w-44"
      >
        <g
          transform="rotate(-7 90 74)"
          stroke="#795449"
          stroke-width="1.2"
          stroke-linejoin="round"
        >
          <rect
            x="42"
            y="16"
            width="96"
            height="116"
            rx="14"
            fill="#FFF8EB"
          ></rect>
          <rect
            x="54"
            y="28"
            width="72"
            height="62"
            rx="8"
            fill="#EEAF99"
          ></rect>
          <path
            d="M90 40c-8 0-14 6.2-14 14.2C76 66 90 84 90 84s14-18 14-29.8C104 46.2 98 40 90 40Z"
            fill="#DF8B73"
          ></path>
          <circle
            cx="90"
            cy="54.2"
            r="3.6"
            fill="#FFF8EB"
            stroke="none"
          ></circle>
          <path d="M62 104h52M62 114h34" stroke="#B6A795"></path>
        </g>
      </svg>

      <h1 class="mt-8 text-4xl/10 font-medium tracking-tight text-balance">
        This page isn’t on the list
      </h1>

      <p class="mt-3 text-base/6 text-pretty text-foreground/65">
        The link may be wrong, or we simply haven’t been there yet.
      </p>

      <a
        href="/"
        class:list={[buttonVariants({ size: "lg" }), "mt-8 w-full sm:w-auto"]}
      >
        See the places
      </a>
    </article>
  </main>
</Layout>

<style>
  .not-found-mark {
    animation: not-found-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes not-found-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-mark {
      animation: none;
    }
  }
</style>
