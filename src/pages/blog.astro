---
import Layout from "@/site/Layout.astro";
import { buttonVariants } from "@/design-system/button";
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/design-system/empty";
import { site } from "@/site/site";
import {
  RiArrowRightLine,
  RiCameraLine,
  RiMapPinLine,
  RiQuillPenLine,
} from "@remixicon/react";
---

<Layout title={`Blog | ${site.name}`} indexable={false}>
  <main class="flex flex-1 bg-border px-6 pb-24">
    <Empty className="px-0 sm:px-12">
      <EmptyHeader>
        <EmptyMedia aria-hidden="true" className="mb-6">
          <div class="flex size-14 translate-x-3 translate-y-2 -rotate-12 items-center justify-center rounded-2xl bg-background text-muted-foreground shadow-sm">
            <RiCameraLine className="size-6" />
          </div>
          <div class="relative z-10 flex size-16 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-md">
            <RiQuillPenLine className="size-7" />
          </div>
          <div class="flex size-14 -translate-x-3 translate-y-2 rotate-12 items-center justify-center rounded-2xl bg-background text-muted-foreground shadow-sm">
            <RiMapPinLine className="size-6" />
          </div>
        </EmptyMedia>
        <EmptyTitle
          role="heading"
          aria-level={1}
          className="text-3xl sm:text-4xl"
        >
          The blog is coming soon
        </EmptyTitle>
        <EmptyDescription className="text-base text-foreground/65">
          Until then, read our reviews of the places we've visited in Bali.
        </EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <a href="/" class={buttonVariants({ size: "lg" })}>
          See the places
          <RiArrowRightLine />
        </a>
      </EmptyContent>
    </Empty>
  </main>
</Layout>
