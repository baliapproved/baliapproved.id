---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { RiMapPinLine } from "@remixicon/react";
import { PlaceCoverCarousel } from "./PlaceCoverCarousel";
import { Seal } from "./Seal";

interface Props {
  place: CollectionEntry<"places">;
}
const { place }: Props = Astro.props;
const { data } = place;

const titleId = `${place.id}-title`;
const visitedDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(data.lastVisitedAt);

const slides = await Promise.all(
  [{ src: data.cover, alt: data.coverAlt }, ...data.gallery].map(
    async (photo) => {
      const image = await getImage({
        src: photo.src,
        widths: [360, 540, 720],
        sizes: "(min-width: 640px) 384px, 72vw",
        format: "webp",
      });

      return {
        src: image.src,
        srcSet: image.srcSet.attribute,
        sizes: (image.attributes.sizes as string | undefined) ?? "72vw",
        width: photo.src.width,
        height: photo.src.height,
        alt: photo.alt,
      };
    },
  ),
);
---

<div class="pt-12 pb-10 sm:pt-16 sm:pb-12 lg:pt-18 lg:pb-14">
  <div class="px-6 sm:px-8">
    <div class="mx-auto w-full max-w-[52rem]">
      <div class="flex justify-center">
        <Seal
          number={data.approvalNumber}
          area={data.sealArea}
          year={data.lastVisitedAt.getUTCFullYear()}
          size={184}
        />
      </div>

      <header class="mx-auto mt-6 max-w-[52rem] text-center sm:mt-7">
        <h1
          id={titleId}
          class="text-[clamp(2.125rem,5.5vw,4.375rem)] leading-[0.96] tracking-[-0.035em] text-balance"
        >
          {data.title}
        </h1>

        <a
          href={data.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-action="maps_click"
          data-placement="place_review"
          data-place-id={place.id}
          data-place-name={data.title}
          class="mt-4 inline-flex max-w-2xl items-start justify-center gap-2 text-[0.8125rem] font-medium text-pretty decoration-foreground/35 underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:text-[0.9375rem]"
        >
          <RiMapPinLine aria-hidden="true" className="mt-0.5 size-4 shrink-0" />
          <span>{data.address}</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>

        <p class="mx-auto mt-4 max-w-[44rem] text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground sm:mt-5 sm:text-[1.0625rem]">
          {data.description}
        </p>
      </header>
    </div>
  </div>

  <div class="mt-8 sm:mt-10">
    <PlaceCoverCarousel
      client:load
      slides={slides}
      label={`Photos of ${data.title}`}
    />
  </div>

  <div class="px-6 sm:px-8">
    <div class="mx-auto w-full max-w-[52rem]">
      <dl class="mt-6 grid grid-cols-1 gap-4 text-center md:mt-7 md:grid-cols-2 md:gap-5">
        <div>
          <dt class="text-[0.6875rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
            Spending
          </dt>
          <dd class="mt-1.5 font-heading text-[1.375rem] tracking-tight sm:text-[1.75rem]">
            {data.spending}
          </dd>
        </div>

        <div>
          <dt class="text-[0.6875rem] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
            Last visited
          </dt>
          <dd class="mt-1.5 font-heading text-[1.375rem] tracking-tight sm:text-[1.75rem]">
            <time datetime={data.lastVisitedAt.toISOString()}>
              {visitedDate}
            </time>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>
