---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { buttonVariants } from "@/design-system/button";
import { RiArrowRightLine, RiMapPinLine } from "@remixicon/react";
import { Seal } from "./Seal";

interface Props {
  places: CollectionEntry<"places">[];
}
const { places }: Props = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<section
  id="places"
  aria-labelledby="places-heading"
  class="scroll-mt-6 pt-14 sm:pt-18 lg:pt-24"
>
  <h2 id="places-heading" class="sr-only">
    Places
  </h2>

  <ol class="list-none p-0">
    {places.map((place, index) => {
      const { data } = place;
      const reversed = index % 2 === 1;
      const visitedDate = dateFormatter.format(data.lastVisitedAt);

      return (
        <li
          class:list={[
            "px-6 py-16 sm:px-8 sm:py-20 lg:py-28",
            index % 2 === 0 ? "bg-muted" : "bg-background",
          ]}
        >
          <article
            aria-labelledby={`${place.id}-listing-title`}
            class="mx-auto grid w-full max-w-6xl items-center gap-x-12 lg:grid-cols-12 xl:gap-x-18"
          >
            <div
              class:list={[
                "relative lg:col-span-7",
                { "lg:order-2": reversed },
              ]}
            >
              <a
                href={`/archived/places/${data.slug}`}
                aria-label={`See why we approved ${data.title}`}
                class="group block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
              >
                <Image
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 1152px) 664px, (min-width: 1024px) 58vw, calc(100vw - 48px)"
                  loading="lazy"
                  class="aspect-5/4 w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.015] motion-safe:group-focus-visible:scale-[1.015] sm:aspect-4/3 lg:aspect-6/5"
                />
              </a>

              <div
                class:list={[
                  "absolute right-4 bottom-0 z-10 translate-y-[34%] sm:right-7",
                  { "lg:right-auto lg:left-7": reversed },
                ]}
              >
                <Seal
                  number={data.approvalNumber}
                  area={data.sealArea}
                  year={data.lastVisitedAt.getUTCFullYear()}
                  size={142}
                />
              </div>
            </div>

            <div
              class:list={[
                "pt-20 lg:col-span-5 lg:pt-0",
                { "lg:order-1": reversed },
              ]}
            >
              <p class="flex flex-wrap items-center gap-x-2 text-sm font-medium text-muted-foreground">
                <span class="text-foreground">{data.sealArea}</span>
                <span aria-hidden="true">·</span>
                <span>
                  Last visited{" "}
                  <time datetime={data.lastVisitedAt.toISOString()}>
                    {visitedDate}
                  </time>
                </span>
              </p>

              <h3
                id={`${place.id}-listing-title`}
                class="mt-4 text-[clamp(2.25rem,4.5vw,4.5rem)] leading-[0.95] tracking-[-0.04em] text-balance"
              >
                <a
                  href={`/archived/places/${data.slug}`}
                  class="transition-colors hover:text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
                >
                  {data.title}
                </a>
              </h3>

              <p class="mt-5 max-w-xl font-heading text-xl leading-relaxed tracking-[-0.01em] text-pretty sm:text-2xl">
                {data.description}
              </p>

              <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
                <div>
                  <dt class="text-[0.625rem] font-semibold tracking-[0.18em] text-muted-foreground uppercase">
                    Spending
                  </dt>
                  <dd class="mt-1.5 font-heading text-xl tracking-tight">
                    {data.spending}
                  </dd>
                </div>
              </dl>

              <div class="mt-8">
                <a
                  href={`/archived/places/${data.slug}`}
                  class:list={[
                    buttonVariants({ size: "lg" }),
                    "w-full justify-between gap-6 sm:w-auto",
                  ]}
                >
                  <span>See why we approved it</span>
                  <RiArrowRightLine
                    aria-hidden="true"
                    data-icon="inline-end"
                    className="motion-safe:transition-transform motion-safe:group-hover/button:translate-x-1 motion-safe:group-focus-visible/button:translate-x-1"
                  />
                </a>
              </div>

              <a
                href={data.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-action="maps_click"
                data-placement="place_listing"
                data-place-id={place.id}
                data-place-name={data.title}
                class="mt-6 inline-flex max-w-xl items-start gap-1 text-sm leading-relaxed text-muted-foreground decoration-foreground/35 underline-offset-4 hover:text-foreground hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
              >
                <RiMapPinLine
                  aria-hidden="true"
                  className="mt-0.5 size-4 shrink-0"
                />
                <span>{data.address}</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
          </article>
        </li>
      );
    })}
  </ol>
</section>
