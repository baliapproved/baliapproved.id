{
  "name": "baliapproved.id",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec wrangler types && vite dev",
    "build": "pnpm typecheck && vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm exec wrangler types && intlayer build && tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@posthog/react": "1.11.3",
    "@remixicon/react": "4.9.0",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "embla-carousel-react": "8.6.0",
    "intlayer": "9.7.0",
    "posthog-js": "1.441.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intlayer": "9.7.0",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nano-staged": "1.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-intlayer": "9.7.0",
    "wrangler": "4.154.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "pnpm exec oxlint --fix --no-error-on-unmatched-pattern",
      "pnpm exec oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,yml,yaml,md}": "pnpm exec oxfmt --no-error-on-unmatched-pattern"
  }
}
